# LLM API Keys
OPENROUTER_KEY=your-openrouter-key-here
GROK_API_KEY=your-groq-key-here
LITELLM_GROQ_API_KEY1=your-groq-key-1
LITELLM_GROQ_API_KEY2=your-groq-key-2
LITELLM_GEMINI_API_KEY1=your-gemini-key-1
LITELLM_GEMINI_API_KEY2=your-gemini-key-2
LITELLM_GEMINI_API_KEY3=your-gemini-key-3

# Database (Supabase)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Upstash)
REDIS_URL=rediss://default:password@your-host.upstash.io:6379

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# App
FRONTEND_URL=http://localhost:5173
